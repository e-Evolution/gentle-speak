{
  "name": "gentle-speak",
  "version": "0.1.0",
  "description": "Opt-in local text-to-speech for Pi and Gentle Shell",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "gentle-shell-extension",
    "text-to-speech"
  ],
  "pi": {
    "extensions": [
      "./extensions/gentle-speak.ts"
    ],
    "image": "./assets/preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions/",
    "lib/",
    "scripts/",
    "assets/preview.png",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --import ./tests/helpers/guard-real-home.ts --test --test-timeout=60000 tests/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "seek-bzip": "2.0.0"
  }
}
