{
  "name": "@e-evolution/gentle-speak",
  "version": "0.1.0",
  "description": "Opt-in local text-to-speech for Pi and Gentle Shell",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Victor Perez <victor.perez@e-evolution.com> (http://www.e-evolution.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-Evolution/gentle-speak.git"
  },
  "keywords": [
    "pi-package",
    "gentle-shell-extension",
    "text-to-speech"
  ],
  "pi": {
    "extensions": [
      "./extensions/gentle-speak.ts"
    ],
    "image": "./assets/preview.png"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "files": [
    "extensions/",
    "lib/",
    "scripts/",
    "!scripts/lock-qwen.mjs",
    "assets/preview.png",
    "assets/logo.svg",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "lock:qwen": "node scripts/lock-qwen.mjs",
    "test": "node --experimental-strip-types --import ./tests/helpers/guard-real-home.ts --test --test-timeout=60000 tests/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "seek-bzip": "2.0.0"
  }
}
